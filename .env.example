DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ninebox
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

ROUND_LENGTH_SECONDS=1800
PAYOUT_MULTIPLIER=9

OTP_EXPIRE_SECONDS=300

# When true, OTP codes are echoed back in the API response (dev_otp) so you
# can test signup/login without a real SMS provider. Set to false in prod.
DEBUG=true
